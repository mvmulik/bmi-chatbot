# TEST environment template
# Load these values from your secret store / pipeline variables.
# Do not commit real secrets. Do not hardcode hostnames here.

APP_NAME=bmi-chatbot
APP_ENV=test
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

CORS_ORIGINS=https://REPLACE_WITH_TEST_FRONTEND_ORIGIN

OPENAI_API_TYPE=azure
OPENAI_API_KEY=REPLACE_WITH_TEST_LLM_API_KEY
OPENAI_API_BASE=https://REPLACE_WITH_TEST_LLM_ENDPOINT
OPENAI_API_VERSION=2024-08-01-preview
OPENAI_DEPLOYMENT_NAME=REPLACE_WITH_TEST_CHAT_DEPLOYMENT
OPENAI_MODEL=REPLACE_WITH_TEST_CHAT_MODEL

OPENAI_EMBEDDING_API_KEY=REPLACE_WITH_TEST_EMBEDDING_API_KEY
OPENAI_EMBEDDING_API_BASE=https://REPLACE_WITH_TEST_EMBEDDING_ENDPOINT
OPENAI_EMBEDDING_API_VERSION=2024-08-01-preview
OPENAI_EMBEDDING_DEPLOYMENT_NAME=REPLACE_WITH_TEST_EMBEDDING_DEPLOYMENT
OPENAI_EMBEDDING_MODEL=REPLACE_WITH_TEST_EMBEDDING_MODEL
EMBEDDING_BATCH_SIZE=64
EMBEDDING_PROVIDER=

CHROMA_PERSIST_DIRECTORY=/data/chroma
CHROMA_COLLECTION_NAME=bmi_documents_test

RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_TEMPERATURE=0.0
RAG_MAX_OUTPUT_TOKENS=800

CRAWLER_START_URL=https://REPLACE_WITH_BMI_HUB_URL/
CRAWLER_ALLOWED_HOSTS=REPLACE_WITH_BMI_HUB_HOST
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_DEPTH=8
CRAWLER_DELAY_SECONDS=0.75
CRAWLER_NAVIGATION_TIMEOUT_MS=60000
CRAWLER_OUTPUT_DIR=/data/raw
CRAWLER_AUTH_DIR=/data/auth
CRAWLER_STORAGE_STATE_PATH=/data/auth/playwright_storage_state.json
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_HEADLESS=true

PROCESSOR_RAW_DIR=/data/raw
PROCESSOR_OUTPUT_DIR=/data/processed
PROCESSOR_CHUNK_SIZE_TOKENS=1000
PROCESSOR_CHUNK_OVERLAP_TOKENS=150
PROCESSOR_MIN_CHUNK_TOKENS=40
PROCESSOR_SOURCE_TYPE=bmi_hub_page
INDEXER_PROCESSED_DIR=/data/processed
INDEXER_BATCH_SIZE=64

VITE_API_BASE_URL=https://REPLACE_WITH_TEST_BACKEND_PUBLIC_URL
