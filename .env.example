# Application
APP_NAME=bmi-chatbot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# OpenAI-compatible API (Azure OpenAI or OpenAI)
# Set OPENAI_API_TYPE to "azure" or "openai"
OPENAI_API_TYPE=azure
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://your-resource.openai.azure.com
OPENAI_API_VERSION=2024-08-01-preview
OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# Optional: use a standard OpenAI-compatible endpoint instead of Azure
# OPENAI_API_TYPE=openai
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=bmi_documents

# Crawler
CRAWLER_START_URL=https://bmihub.burnsmcd.com/
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_DEPTH=8
CRAWLER_DELAY_SECONDS=0.75
CRAWLER_NAVIGATION_TIMEOUT_MS=60000
CRAWLER_OUTPUT_DIR=./data/raw
CRAWLER_AUTH_DIR=./data/auth
CRAWLER_STORAGE_STATE_PATH=./data/auth/playwright_storage_state.json
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_HEADLESS=true

# Processor
PROCESSOR_RAW_DIR=./data/raw
PROCESSOR_OUTPUT_DIR=./data/processed
PROCESSOR_CHUNK_SIZE_TOKENS=1000
PROCESSOR_CHUNK_OVERLAP_TOKENS=150
PROCESSOR_MIN_CHUNK_TOKENS=40
PROCESSOR_SOURCE_TYPE=bmi_hub_page

EMBEDDING_BATCH_SIZE=64
EMBEDDING_PROVIDER=
# Set EMBEDDING_PROVIDER=hash only for offline tests (not production quality)

# Indexer
INDEXER_PROCESSED_DIR=./data/processed
INDEXER_BATCH_SIZE=64

