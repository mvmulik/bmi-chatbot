# Shared template for all environments.
# Copy to a concrete file for your target environment, then fill in values.
# Never commit real secrets.
#
# Examples:
#   copy .env.example .env
#   copy .env.local.example .env.local
#   copy .env.dev.example .env.dev
#   copy .env.test.example .env.test

############################
# Application
############################
APP_NAME=bmi-chatbot
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

############################
# LLM (chat completions)
############################
# azure | openai
OPENAI_API_TYPE=azure
OPENAI_API_KEY=REPLACE_WITH_LLM_API_KEY
OPENAI_API_BASE=https://REPLACE_WITH_LLM_ENDPOINT
OPENAI_API_VERSION=2024-08-01-preview
OPENAI_DEPLOYMENT_NAME=REPLACE_WITH_CHAT_DEPLOYMENT_OR_MODEL
OPENAI_MODEL=REPLACE_WITH_CHAT_MODEL_NAME

############################
# Embeddings (optional overrides; fall back to LLM settings when blank)
############################
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_API_BASE=
OPENAI_EMBEDDING_API_VERSION=
OPENAI_EMBEDDING_DEPLOYMENT_NAME=REPLACE_WITH_EMBEDDING_DEPLOYMENT_OR_MODEL
OPENAI_EMBEDDING_MODEL=REPLACE_WITH_EMBEDDING_MODEL_NAME
EMBEDDING_BATCH_SIZE=64
EMBEDDING_PROVIDER=
# Set EMBEDDING_PROVIDER=hash only for offline non-production tests

############################
# Vector database (Chroma)
############################
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=bmi_documents

############################
# RAG behavior
############################
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_TEMPERATURE=0.1
RAG_MAX_OUTPUT_TOKENS=800

############################
# BMI Hub crawler / auth session
############################
CRAWLER_START_URL=https://REPLACE_WITH_BMI_HUB_URL/
CRAWLER_ALLOWED_HOSTS=
# If blank, host is derived from CRAWLER_START_URL
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_DEPTH=8
CRAWLER_DELAY_SECONDS=0.75
CRAWLER_NAVIGATION_TIMEOUT_MS=60000
CRAWLER_OUTPUT_DIR=./data/raw
CRAWLER_AUTH_DIR=./data/auth
CRAWLER_STORAGE_STATE_PATH=./data/auth/playwright_storage_state.json
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_HEADLESS=true

############################
# Processor / indexer
############################
PROCESSOR_RAW_DIR=./data/raw
PROCESSOR_OUTPUT_DIR=./data/processed
PROCESSOR_CHUNK_SIZE_TOKENS=1000
PROCESSOR_CHUNK_OVERLAP_TOKENS=150
PROCESSOR_MIN_CHUNK_TOKENS=40
PROCESSOR_SOURCE_TYPE=bmi_hub_page
INDEXER_PROCESSED_DIR=./data/processed
INDEXER_BATCH_SIZE=64

############################
# Frontend (build-time; also see frontend/.env.example)
############################
# VITE_API_BASE_URL=https://REPLACE_WITH_BACKEND_PUBLIC_URL
