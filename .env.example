# Application
APP_NAME=bmi-chatbot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# OpenAI-compatible API (Azure OpenAI or OpenAI)
# Set OPENAI_API_TYPE to "azure" or "openai"
OPENAI_API_TYPE=azure
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://your-resource.openai.azure.com
OPENAI_API_VERSION=2024-08-01-preview
OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# Optional: use a standard OpenAI-compatible endpoint instead of Azure
# OPENAI_API_TYPE=openai
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=bmi_documents

# Crawler (reserved for future use)
CRAWLER_START_URL=
CRAWLER_MAX_PAGES=50
CRAWLER_OUTPUT_DIR=./data/raw
